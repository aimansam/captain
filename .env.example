# Required, at least 8 characters
ADMIN_PASSWORD=change-me-to-something-long
# Optional: keeps sessions valid across restarts (openssl rand -hex 32)
SESSION_SECRET=
PORT=8787
# Set to true when served over HTTPS (reverse proxy, tunnel)
SECURE_COOKIE=false
# Set to true to disable every action (view-only dashboard)
READ_ONLY=false
